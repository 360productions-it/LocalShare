<Window x:Class="LocalShare.App.Views.ShellView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:LocalShare.App.ViewModels"
        xmlns:views="clr-namespace:LocalShare.App.Views"
        xmlns:behaviors="clr-namespace:LocalShare.App.Behaviors"
        Title="360 LocalShare - Ultra P2P LAN Sharing &amp; Messenger"
        Icon="pack://application:,,,/Assets/360-logo.png"
        Height="780" Width="1200" MinHeight="640" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A"
        behaviors:AdaptiveLayoutBehavior.CompactWidthThreshold="880">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <DataTemplate DataType="{x:Type vm:PeersViewModel}">
            <views:PeersView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ChatViewModel}">
            <views:ChatView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PublicSpaceViewModel}">
            <views:PublicSpaceView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GroupsViewModel}">
            <views:GroupsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TransfersViewModel}">
            <views:TransfersView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProfileSettingsViewModel}">
            <views:ProfileSettingsView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" x:Name="NavColumn"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar Navigation Rail -->
        <Border Background="#0B0F19" BorderBrush="#1E293B" BorderThickness="0,0,1,0">
            <DockPanel Margin="12,15">
                <!-- App Title & User Badge Header -->
                <StackPanel DockPanel.Dock="Top" Margin="5,10,5,25">
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Brand Logo Image -->
                        <Image Source="pack://application:,,,/Assets/360-logo.png" Width="42" Height="42" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="LocalShare " FontSize="18" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="{Binding AppVersion}" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Bottom" Margin="2,0,0,2"/>
                            </StackPanel>
                            <TextBlock Text="P2P LAN Network" FontSize="11" Foreground="#94A3B8" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>

                    <!-- Logged-in User Pill -->
                    <Border Background="#1E293B" CornerRadius="8" Padding="10,8" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Fill="#10B981" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="Online &amp; Broadcasting" FontSize="10" Foreground="#94A3B8"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Navigation Links -->
                <StackPanel>
                    <RadioButton Content="🌐 Discovered Peers" Command="{Binding NavigateCommand}" CommandParameter="Peers" IsChecked="True" Style="{StaticResource NavRadioButtonStyle}"/>
                    <RadioButton Content="💬 Instant Messenger" Command="{Binding NavigateCommand}" CommandParameter="Chat" Style="{StaticResource NavRadioButtonStyle}"/>
                    <RadioButton Content="📁 Public Space" Command="{Binding NavigateCommand}" CommandParameter="PublicSpace" Style="{StaticResource NavRadioButtonStyle}"/>
                    <RadioButton Content="👥 LAN Groups" Command="{Binding NavigateCommand}" CommandParameter="Groups" Style="{StaticResource NavRadioButtonStyle}"/>
                    <RadioButton Content="⚡ Transfers &amp; Logs" Command="{Binding NavigateCommand}" CommandParameter="Transfers" Style="{StaticResource NavRadioButtonStyle}"/>
                    <RadioButton Content="⚙️ Settings &amp; Profile" Command="{Binding NavigateCommand}" CommandParameter="Profile" Style="{StaticResource NavRadioButtonStyle}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Workspace Area -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}" Background="#0F172A"/>
    </Grid>
</Window>
