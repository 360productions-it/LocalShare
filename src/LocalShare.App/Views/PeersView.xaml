<UserControl x:Class="LocalShare.App.Views.PeersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True"
             Drop="UserControl_Drop"
             DragOver="UserControl_DragOver">
    
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Title Bar -->
        <Grid Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <Image Source="pack://application:,,,/Assets/360-logo.png" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="LAN Peer Discovery &amp; File Transfer" FontSize="24" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Action Bar: Scan LAN & Direct IP Connect -->
        <Border Grid.Row="1" Background="#1E293B" CornerRadius="10" Padding="14,10" Margin="0,0,0,16" BorderBrush="#334155" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Content="🔍 Scan LAN Network" Command="{Binding ScanNetworkCommand}" Style="{StaticResource ModernPrimaryButton}"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Text="Direct IP Connect: " Foreground="#94A3B8" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Margin="0,0,8,0"/>
                    <TextBox Text="{Binding ManualIpInput, UpdateSourceTrigger=PropertyChanged}" Width="160" Background="#0F172A" Foreground="White" BorderBrush="#334155" Padding="10,6" VerticalContentAlignment="Center" FontSize="13"/>
                    <Button Content="Connect" Command="{Binding ConnectDirectIpCommand}" Background="#334155" Foreground="White" FontWeight="Bold" Padding="14,6" Margin="8,0,0,0" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status Message Banner -->
        <Border Grid.Row="2" Background="#1E3A5F" BorderBrush="#38BDF8" BorderThickness="1" Padding="14,9" CornerRadius="8" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚡ " FontSize="14" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding StatusMessage}" Foreground="#38BDF8" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Main Peer Grid & Staged Files Split Area -->
        <Grid Grid.Row="3" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>

            <!-- Peer Cards List -->
            <ScrollViewer Grid.Column="0" Margin="0,0,16,0" VerticalScrollBarVisibility="Auto">
                <DockPanel>
                    <!-- Peer Multi-Select Toolbar -->
                    <Grid DockPanel.Dock="Top" Margin="2,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="1. Select Target Peers:" Foreground="#94A3B8" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <Button Content="☑️ Select All" Command="{Binding SelectAllPeersCommand}" Background="#334155" Foreground="White" FontSize="12" FontWeight="SemiBold" Padding="10,5" Margin="0,0,8,0" Cursor="Hand"/>
                            <Button Content="🔳 Deselect All" Command="{Binding DeselectAllPeersCommand}" Background="#1E293B" Foreground="#94A3B8" FontSize="12" Padding="10,5" Cursor="Hand"/>
                        </StackPanel>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Peers}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="280" Margin="8" Padding="16" Background="#1E293B" CornerRadius="14" BorderBrush="#38BDF8" BorderThickness="2" AllowDrop="True" Drop="PeerCard_Drop" MouseLeftButtonDown="PeerCard_MouseLeftButtonDown" Cursor="Hand">
                                    <StackPanel>
                                        <!-- Top Row: High-Visibility Checkbox & Online Badge -->
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Prominent Checkbox -->
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Style="{StaticResource HighVisibilityCheckBoxStyle}" VerticalAlignment="Center"/>

                                            <!-- Online Badge -->
                                            <Border Grid.Column="2" Background="#064E3B" BorderBrush="#10B981" BorderThickness="1" CornerRadius="10" Padding="8,4" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Online" FontSize="11" Foreground="#34D399" FontWeight="Bold"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- Profile Section: Avatar & Peer Name -->
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Width="46" Height="46" CornerRadius="23" Background="{StaticResource PrimaryGradient}" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName[0]}" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="17" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                                <Border Background="#0F172A" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="0,4,0,0">
                                                    <TextBlock Text="{Binding IpAddress, StringFormat='IP: {0}'}" FontSize="11" Foreground="#38BDF8" FontWeight="SemiBold"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Interactive Public Space Button -->
                                        <Button Command="{Binding DataContext.OpenPublicSpaceForPeerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Visibility="{Binding HasPublicSpace, Converter={StaticResource BooleanToVisibilityConverter}}" Background="#1E3A5F" BorderBrush="#38BDF8" BorderThickness="1" HorizontalAlignment="Stretch" Margin="0,2,0,14" Padding="10,6" Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <TextBlock Text="📁 Explore Public Space ↗" FontSize="12" FontWeight="Bold" Foreground="#38BDF8"/>
                                                        </StackPanel>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <!-- Action Buttons: Select Target & Start Chat -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Content="🎯 Target" Command="{Binding DataContext.TogglePeerSelectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource ModernPrimaryButton}" Margin="0,0,4,0"/>
                                            <Button Grid.Column="1" Content="💬 Chat" Command="{Binding DataContext.StartChatWithPeerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource ModernSuccessButton}" Margin="4,0,0,0"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </ScrollViewer>

            <!-- Staged Files Queue & Send Zone (Right Panel) -->
            <Border Grid.Column="1" Background="#1E293B" CornerRadius="12" Padding="16" BorderBrush="#334155" BorderThickness="1">
                <DockPanel>
                    <TextBlock Text="📥 2. Files Ready to Send" FontSize="17" FontWeight="Bold" Foreground="White" DockPanel.Dock="Top" Margin="0,0,0,4"/>
                    <TextBlock Text="Select target peer(s) on the left, then hit Send" FontSize="12" Foreground="#38BDF8" FontWeight="SemiBold" DockPanel.Dock="Top" Margin="0,0,0,14"/>

                    <!-- Action Buttons -->
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="➕ Add Files" Command="{Binding AddStagedFilesCommand}" Background="#334155" Foreground="White" FontWeight="Bold" Padding="14,7" Cursor="Hand"/>
                        <Button Grid.Column="1" Content="Clear All" Command="{Binding ClearStagedFilesCommand}" Background="#451A1A" Foreground="#FCA5A5" FontWeight="Bold" Padding="12,7" Margin="8,0,0,0" Cursor="Hand"/>
                    </Grid>

                    <!-- Large SEND NOW Button with Y-Axis Padding & Margin -->
                    <Button DockPanel.Dock="Bottom" Command="{Binding SendStagedFilesNowCommand}" Background="{StaticResource SendNowGradient}" Foreground="White" FontSize="16" FontWeight="Bold" Padding="0,18" Margin="0,18,0,10" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🚀 SEND FILES NOW "/>
                            <TextBlock Text="{Binding StagedFiles.Count, StringFormat='({0} files)'}"/>
                        </StackPanel>
                    </Button>

                    <!-- Staged File Items List -->
                    <Border Background="#0F172A" CornerRadius="8" Padding="8">
                        <ListBox ItemsSource="{Binding StagedFiles}" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="4" Padding="10,8" Background="#1E293B" CornerRadius="8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="{Binding FileIcon}" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FileName}" Foreground="White" FontSize="13" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding FormattedSize}" Foreground="#94A3B8" FontSize="11"/>
                                            </StackPanel>

                                            <Button Grid.Column="2" Content="❌" Command="{Binding DataContext.RemoveStagedFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="Transparent" Foreground="#EF4444" FontSize="14" BorderThickness="0" Margin="8,0,0,0" Cursor="Hand"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Live Active Transfers Bar with Real-time Progress Bars & Toggle / Cancel -->
        <Border Grid.Row="4" Background="#1E293B" CornerRadius="12" Padding="16" BorderBrush="#0078D4" BorderThickness="1">
            <DockPanel>
                <!-- Collapsible Header Bar -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚡ Live P2P Transfers &amp; Real-time Progress" FontSize="17" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <TextBlock Text="Real-time chunk streaming" FontSize="12" Foreground="#38BDF8" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <Button Command="{Binding ToggleLiveTransfersCommand}" Background="#334155" Foreground="White" FontSize="12" FontWeight="Bold" Padding="12,5" HorizontalAlignment="Right" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👁️ Toggle View/Hide Progress"/>
                        </StackPanel>
                    </Button>
                </Grid>
                
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="200" Visibility="{Binding ShowLiveTransfers, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl ItemsSource="{Binding ActiveTransfers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,4" Padding="12,10" Background="#0F172A" CornerRadius="8" BorderBrush="#334155" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="160"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- File Name & Size -->
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FileName}" Foreground="White" FontWeight="Bold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding FormattedSize, StringFormat='Size: {0}'}" Foreground="#94A3B8" FontSize="11"/>
                                        </StackPanel>

                                        <!-- Target Peer Pill -->
                                        <Border Grid.Column="1" Background="#1E293B" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding PeerDisplayName, StringFormat='Peer: {0}'}" Foreground="#CBD5E1" FontSize="11" FontWeight="SemiBold"/>
                                        </Border>

                                        <!-- Progress Bar -->
                                        <ProgressBar Grid.Column="2" Value="{Binding ProgressPercentage, Mode=OneWay}" Maximum="100" Height="18" Foreground="{StaticResource PrimaryGradient}" Background="#1E293B" VerticalAlignment="Center" Margin="14,0"/>

                                        <!-- Transferred Details -->
                                        <TextBlock Grid.Column="3" Text="{Binding FormattedProgressDetails, Mode=OneWay}" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                        <!-- Status Badge & Cancel Button -->
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StatusText, Mode=OneWay}" Foreground="{Binding StatusColor, Mode=OneWay}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <Button Content="🛑 Cancel" Command="{Binding DataContext.CancelTransferCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Visibility="{Binding CanCancel, Converter={StaticResource BooleanToVisibilityConverter}}" Background="#451A1A" Foreground="#FCA5A5" FontSize="11" FontWeight="Bold" Padding="8,4" Margin="8,0,0,0" Cursor="Hand"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
