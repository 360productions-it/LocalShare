<UserControl x:Class="LocalShare.App.Views.PublicSpaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Title Bar -->
        <TextBlock Text="📁 Public Space Browser" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,0,0,16"/>
        
        <!-- Action & Peer Selection Bar -->
        <Border Grid.Row="1" Background="#1E293B" CornerRadius="12" Padding="16,12" Margin="0,0,0,16" BorderBrush="#334155" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Select LAN Peer:" Foreground="White" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                
                <!-- High Visibility ComboBox -->
                <ComboBox Grid.Column="1" ItemsSource="{Binding Peers}" SelectedItem="{Binding SelectedPeer}" Width="280" Background="#0F172A" Foreground="White" BorderBrush="#38BDF8" BorderThickness="2" FontSize="14" VerticalContentAlignment="Center" Cursor="Hand">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="6,4" Background="#1E293B" CornerRadius="6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="💻 " FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding IpAddress, StringFormat=' ({0})'}" Foreground="#38BDF8" FontSize="12" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button Content="🔄 Refresh Peers" Command="{Binding RefreshPeersCommand}" Background="#334155" Foreground="White" FontWeight="Bold" Padding="14,8" Cursor="Hand" Margin="0,0,8,0"/>
                    <Button Content="📥 Open Downloads Folder" Command="{Binding OpenReceivedFolderCommand}" Style="{StaticResource ModernPrimaryButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status Message Banner -->
        <Border Grid.Row="2" Background="#1E3A5F" BorderBrush="#38BDF8" BorderThickness="1" Padding="14,9" CornerRadius="8" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚡ " FontSize="14" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding StatusMessage}" Foreground="#38BDF8" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Public Files Grid Browser -->
        <Border Grid.Row="3" Background="#1E293B" CornerRadius="12" Padding="16" BorderBrush="#334155" BorderThickness="1">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="32" Height="32" CornerRadius="16" Background="{StaticResource PrimaryGradient}" Margin="0,0,10,0">
                            <TextBlock Text="📁" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding SelectedPeer.DisplayName, StringFormat='Shared Public Files ({0})', FallbackValue='Shared Public Files'}" FontSize="17" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>
                    
                    <TextBlock Text="Read-Only Shared on LAN" FontSize="12" Foreground="#34D399" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding PublicFiles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,4" Padding="14,10" Background="#0F172A" CornerRadius="10" BorderBrush="#334155" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="130"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- File Extension Icon -->
                                        <TextBlock Text="{Binding FileIcon}" FontSize="22" VerticalAlignment="Center" Margin="0,0,12,0"/>

                                        <!-- File Name -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FileName}" Foreground="White" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <!-- Relative Path Pill -->
                                        <Border Grid.Column="2" Background="#1E293B" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding RelativePath, StringFormat='Path: /{0}'}" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        </Border>

                                        <!-- Formatted Size -->
                                        <TextBlock Grid.Column="3" Text="{Binding FormattedSize}" Foreground="#38BDF8" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                        <!-- Download Button -->
                                        <Button Grid.Column="4" Content="⬇️ Download" Command="{Binding DataContext.DownloadFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource ModernPrimaryButton}" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
