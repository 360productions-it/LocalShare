<UserControl x:Class="LocalShare.App.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True"
             Drop="ChatView_Drop"
             DragOver="ChatView_DragOver">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Conversations Sidebar List -->
        <Border Background="#1E293B" CornerRadius="12" Margin="0,0,16,0" Padding="14" BorderBrush="#334155" BorderThickness="1">
            <DockPanel>
                <TextBlock Text="💬 Conversations" FontSize="18" FontWeight="Bold" Foreground="White" DockPanel.Dock="Top" Margin="0,0,0,14"/>
                
                <ListBox ItemsSource="{Binding Conversations}" SelectedItem="{Binding SelectedConversation}" Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,3" Padding="12,10" Background="#0F172A" CornerRadius="8" BorderBrush="#334155" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="{Binding LastMessageAt, StringFormat='{}{0:g}'}" FontSize="11" Foreground="#94A3B8" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Main Chat & Messages Panel -->
        <Border Grid.Column="1" Background="#1E293B" CornerRadius="12" BorderBrush="#334155" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Background="#0F172A" Padding="18,14" CornerRadius="12,12,0,0" BorderBrush="#334155" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource PrimaryGradient}">
                            <TextBlock Text="💬" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock Text="{Binding SelectedConversation.DisplayName, FallbackValue='Select a conversation to start chatting'}" FontSize="17" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="{Binding TypingText}" FontSize="11" Foreground="#38BDF8" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Messages Stream -->
                <ScrollViewer Grid.Row="1" Margin="18">
                    <ItemsControl ItemsSource="{Binding Messages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,6" Padding="14,10" Background="#0F172A" CornerRadius="10" HorizontalAlignment="Left" MaxWidth="520" BorderBrush="#334155" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="{Binding SenderDisplayName}" FontSize="12" FontWeight="Bold" Foreground="#38BDF8"/>
                                        <TextBlock Text="{Binding Body}" FontSize="14" Foreground="White" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        
                                        <Border Visibility="{Binding AttachmentFileName, Converter={StaticResource BooleanToVisibilityConverter}}" Background="#1E293B" CornerRadius="6" Padding="8,5" Margin="0,6,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="📄" FontSize="14" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding AttachmentFileName}" Foreground="#38BDF8" FontSize="12" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Border>

                                        <TextBlock Text="{Binding SentAt, StringFormat='{}{0:t}'}" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Right" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Attachment Active Pill Bar -->
                <Border Grid.Row="2" Background="#0F172A" Padding="12,8" Visibility="{Binding SelectedAttachmentPath, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📎 Attachment Ready: " Foreground="#38BDF8" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SelectedAttachmentPath}" Foreground="White" VerticalAlignment="Center" Margin="6,0"/>
                        <Button Content="❌ Remove" Command="{Binding ClearAttachmentCommand}" Background="Transparent" Foreground="#EF4444" BorderThickness="0" Margin="12,0,0,0" Cursor="Hand"/>
                    </StackPanel>
                </Border>

                <!-- Message Input & Send Control -->
                <Grid Grid.Row="3" Margin="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Content="📎 Attach" Command="{Binding SelectAttachmentCommand}" Background="#334155" Foreground="White" FontWeight="Bold" Padding="14,8" Margin="0,0,8,0" Cursor="Hand"/>
                    <TextBox Grid.Column="1" Text="{Binding MessageInput, UpdateSourceTrigger=PropertyChanged}" Background="#0F172A" Foreground="White" BorderBrush="#334155" Padding="12,8" VerticalContentAlignment="Center" FontSize="14"/>
                    <Button Grid.Column="2" Content="🚀 Send Message" Command="{Binding SendMessageCommand}" Style="{StaticResource ModernPrimaryButton}" Margin="8,0,0,0"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
