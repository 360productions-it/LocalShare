<UserControl x:Class="LocalShare.App.Views.ProfileSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="780" HorizontalAlignment="Left">
                <!-- Top Title Bar -->
                <TextBlock Text="⚙️ Profile &amp; Storage Dashboard" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,0,0,4"/>
                <TextBlock Text="Customize your LAN user identity, accent color palette, and local storage directories." FontSize="13" Foreground="#94A3B8" Margin="0,0,0,20"/>

                <!-- Status Message Banner -->
                <Border Visibility="{Binding StatusMessage, Converter={StaticResource BooleanToVisibilityConverter}}" Background="#1E3A5F" BorderBrush="#38BDF8" BorderThickness="1" Padding="14,9" CornerRadius="8" Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="ℹ️ " FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="#38BDF8" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- CARD 1: Identity & Accent Color -->
                <Border Background="#1E293B" CornerRadius="12" Padding="20" Margin="0,0,0,20" BorderBrush="#334155" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="👤 User Identity &amp; Accent Palette" FontSize="17" FontWeight="Bold" Foreground="White" Margin="0,0,0,16"/>

                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Avatar Live Preview Circle -->
                            <Border Width="64" Height="64" CornerRadius="32" Background="{Binding AccentColor}" VerticalAlignment="Top" Margin="0,0,20,0">
                                <TextBlock Text="{Binding DisplayName[0]}" FontSize="26" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- Display Name & Hex Input -->
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Display Name" Foreground="White" FontSize="13" FontWeight="Bold" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Background="#0F172A" Foreground="White" BorderBrush="#334155" Padding="10,8" FontSize="14" Margin="0,0,0,14"/>

                                <TextBlock Text="Accent Color (Hex)" Foreground="White" FontSize="13" FontWeight="Bold" Margin="0,0,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding AccentColor, UpdateSourceTrigger=PropertyChanged}" Background="#0F172A" Foreground="White" BorderBrush="#334155" Padding="10,8" FontSize="14"/>
                                    <Border Grid.Column="1" Width="36" Height="36" CornerRadius="6" Background="{Binding AccentColor}" Margin="8,0,0,0" BorderBrush="#334155" BorderThickness="1"/>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <!-- Color Preset Swatches Palette -->
                        <TextBlock Text="Select Preset Color Theme:" Foreground="#94A3B8" FontSize="12" FontWeight="Bold" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding ColorPresets}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.SelectPresetColorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="{Binding}" Width="40" Height="40" Margin="0,0,10,0" BorderThickness="0" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="20" BorderBrush="#FFFFFF" BorderThickness="2">
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- CARD 2: Storage & Folder Management -->
                <Border Background="#1E293B" CornerRadius="12" Padding="20" Margin="0,0,0,20" BorderBrush="#334155" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="📂 Storage &amp; Shared Folders" FontSize="17" FontWeight="Bold" Foreground="White" Margin="0,0,0,16"/>

                        <!-- Public Space Folder -->
                        <TextBlock Text="Public Space Folder (Read-Only Shared on LAN)" Foreground="White" FontSize="13" FontWeight="Bold" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding PublicSpacePath}" IsReadOnly="True" Background="#0F172A" Foreground="#38BDF8" BorderBrush="#334155" Padding="10,8" FontSize="13"/>
                            <Button Grid.Column="1" Content="📂 Browse..." Command="{Binding BrowsePublicSpaceFolderCommand}" Background="#334155" Foreground="White" FontWeight="Bold" Padding="14,0" Margin="8,0,0,0" Cursor="Hand"/>
                            <Button Grid.Column="2" Content="📁 Open" Command="{Binding OpenFolderInExplorerCommand}" CommandParameter="{Binding PublicSpacePath}" Background="#0F172A" Foreground="#94A3B8" Padding="12,0" Margin="6,0,0,0" Cursor="Hand"/>
                        </Grid>

                        <!-- Received Files Folder -->
                        <TextBlock Text="Received Files Storage Root" Foreground="White" FontSize="13" FontWeight="Bold" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding ReceivedFilesRoot}" IsReadOnly="True" Background="#0F172A" Foreground="#34D399" BorderBrush="#334155" Padding="10,8" FontSize="13"/>
                            <Button Grid.Column="1" Content="📂 Browse..." Command="{Binding BrowseReceivedFilesFolderCommand}" Background="#334155" Foreground="White" FontWeight="Bold" Padding="14,0" Margin="8,0,0,0" Cursor="Hand"/>
                            <Button Grid.Column="2" Content="📥 Open" Command="{Binding OpenFolderInExplorerCommand}" CommandParameter="{Binding ReceivedFilesRoot}" Background="#0F172A" Foreground="#94A3B8" Padding="12,0" Margin="6,0,0,0" Cursor="Hand"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- CARD 3: Device Info -->
                <Border Background="#1E293B" CornerRadius="12" Padding="20" Margin="0,0,0,20" BorderBrush="#334155" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="📱 Device Information" FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding LocalIp, StringFormat='Local IP: {0}'}" Foreground="#38BDF8" FontSize="12" FontWeight="Bold" Margin="0,0,15,0"/>
                                <TextBlock Text="{Binding DeviceId, StringFormat='Device ID: {0}'}" Foreground="#94A3B8" FontSize="11" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </StackPanel>

                        <Button Grid.Column="1" Content="📋 Copy Device ID" Command="{Binding CopyDeviceIdToClipboardCommand}" Background="#334155" Foreground="White" FontSize="12" FontWeight="Bold" Padding="12,6" Cursor="Hand"/>
                    </Grid>
                </Border>

                <!-- CARD 4: Software Updates & Maintenance -->
                <Border Background="#1E293B" CornerRadius="12" Padding="20" Margin="0,0,0,20" BorderBrush="#0078D4" BorderThickness="1">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🚀 Software Updates &amp; Release Maintenance" FontSize="17" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <Border Background="#0F172A" CornerRadius="6" Padding="8,4">
                                    <TextBlock Text="{Binding CurrentVersion}" Foreground="#38BDF8" FontSize="12" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                            <Button Content="🔍 Check for Updates" Command="{Binding CheckForUpdatesCommand}" Background="#334155" Foreground="White" FontSize="12" FontWeight="Bold" Padding="14,6" HorizontalAlignment="Right" Cursor="Hand"/>
                        </Grid>

                        <!-- Status text -->
                        <TextBlock Text="{Binding UpdateStatusMessage}" Foreground="#CBD5E1" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,12"/>

                        <!-- Update Progress Bar (visible during download) -->
                        <ProgressBar Visibility="{Binding IsDownloadingUpdate, Converter={StaticResource BooleanToVisibilityConverter}}" Value="{Binding UpdateProgressPercentage, Mode=OneWay}" Maximum="100" Height="14" Foreground="{StaticResource PrimaryGradient}" Background="#0F172A" Margin="0,0,0,12"/>

                        <!-- Update Available Banner & Action -->
                        <Border Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BooleanToVisibilityConverter}}" Background="#0F172A" CornerRadius="8" Padding="14" BorderBrush="#10B981" BorderThickness="1">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="📥 Download &amp; Install Update Now" Command="{Binding ApplyUpdateCommand}" Background="#10B981" Foreground="White" FontSize="13" FontWeight="Bold" Padding="16,8" Cursor="Hand"/>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding AvailableUpdateInfo.Version, StringFormat='Update Available: v{0}'}" Foreground="#34D399" FontSize="14" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding AvailableUpdateInfo.Changelog}" Foreground="#94A3B8" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- SAVE BUTTON -->
                <Button Content="💾 Save Profile Settings" Command="{Binding SaveProfileCommand}" Style="{StaticResource ModernPrimaryButton}" FontSize="16" Padding="24,12" HorizontalAlignment="Left"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
