<UserControl x:Class="LocalShare.App.Views.ProfileSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28,24,28,20">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="820" HorizontalAlignment="Left">

                <!-- ═══════════════════════════════════ -->
                <!-- TOP TITLE BAR                      -->
                <!-- ═══════════════════════════════════ -->
                <StackPanel Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Border Width="34" Height="34" CornerRadius="10" VerticalAlignment="Center" Margin="0,0,12,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#2563EB" Offset="0"/>
                                    <GradientStop Color="#7C3AED" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" Color="#2563EB" Direction="0" ShadowDepth="0" Opacity="0.2"/>
                            </Border.Effect>
                            <TextBlock Text="⚙" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Profile &amp; Settings" FontSize="26" FontWeight="Bold" VerticalAlignment="Center">
                            <TextBlock.Foreground>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#60A5FA" Offset="0.0"/>
                                    <GradientStop Color="#38BDF8" Offset="0.5"/>
                                    <GradientStop Color="#818CF8" Offset="1.0"/>
                                </LinearGradientBrush>
                            </TextBlock.Foreground>
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Text="Customize your LAN identity, accent color palette, and local storage directories." FontSize="13" Foreground="#64748B" Margin="0,0,0,22"/>
                </StackPanel>

                <!-- ═══════════════════════════════════ -->
                <!-- STATUS MESSAGE BANNER              -->
                <!-- ═══════════════════════════════════ -->
                <Border Visibility="{Binding StatusMessage, Converter={StaticResource BooleanToVisibilityConverter}}" CornerRadius="10" Padding="14,10" Margin="0,0,0,20" BorderThickness="1">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#0C1A33" Offset="0"/>
                            <GradientStop Color="#0F1D38" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.BorderBrush>
                        <SolidColorBrush Color="#3B82F6" Opacity="0.3"/>
                    </Border.BorderBrush>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="ℹ️ " FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="#60A5FA" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- ═══════════════════════════════════════════ -->
                <!-- CARD 1: User Identity & Accent Palette     -->
                <!-- ═══════════════════════════════════════════ -->
                <Border CornerRadius="14" Padding="22" Margin="0,0,0,20" BorderThickness="1" BorderBrush="#1A2744">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#0E1525" Offset="0"/>
                            <GradientStop Color="#0B1120" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <TextBlock Text="👤" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="User Identity &amp; Accent Palette" FontSize="16" FontWeight="Bold" Foreground="#F1F5F9" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Grid Margin="0,0,0,22">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Avatar Preview Circle -->
                            <Border Width="84" Height="84" CornerRadius="42" Background="{Binding AccentColor}" VerticalAlignment="Top" Margin="0,0,24,0">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16" Color="#2563EB" Direction="0" ShadowDepth="0" Opacity="0.2"/>
                                </Border.Effect>
                                <TextBlock Text="{Binding DisplayName[0]}" FontSize="34" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- Form Fields -->
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Display Name" Foreground="#F1F5F9" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" 
                                         Background="#0D1321" Foreground="White" BorderBrush="#1E293B" BorderThickness="1"
                                         Padding="12,10" FontSize="14" CaretBrush="#60A5FA" SelectionBrush="#2563EB" Margin="0,0,0,16"/>

                                <TextBlock Text="Accent Color (Hex)" Foreground="#F1F5F9" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding AccentColor, UpdateSourceTrigger=PropertyChanged}" 
                                             Background="#0D1321" Foreground="White" BorderBrush="#1E293B" BorderThickness="1"
                                             Padding="12,10" FontSize="14" CaretBrush="#60A5FA" SelectionBrush="#2563EB"/>
                                    <Border Grid.Column="1" Width="44" Height="44" CornerRadius="10" Background="{Binding AccentColor}" Margin="12,0,0,0" BorderBrush="#334155" BorderThickness="1">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="8" Color="#000000" Direction="270" ShadowDepth="2" Opacity="0.3"/>
                                        </Border.Effect>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <!-- Color Preset Swatches -->
                        <TextBlock Text="Select Preset Color Theme:" Foreground="#64748B" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <ItemsControl ItemsSource="{Binding ColorPresets}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.SelectPresetColorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="{Binding}" Width="42" Height="42" Margin="0,0,10,0" BorderThickness="0" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="swatchBd" Background="{TemplateBinding Background}" CornerRadius="21" BorderBrush="Transparent" BorderThickness="2.5">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="6" Color="#000000" Direction="270" ShadowDepth="2" Opacity="0.3"/>
                                                    </Border.Effect>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="swatchBd" Property="BorderBrush" Value="White"/>
                                                        <Setter TargetName="swatchBd" Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect BlurRadius="14" Color="White" Direction="0" ShadowDepth="0" Opacity="0.4"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ═══════════════════════════════════════════ -->
                <!-- CARD 2: Storage & Folder Management        -->
                <!-- ═══════════════════════════════════════════ -->
                <Border CornerRadius="14" Padding="22" Margin="0,0,0,20" BorderThickness="1" BorderBrush="#1A2744">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#0E1525" Offset="0"/>
                            <GradientStop Color="#0B1120" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <TextBlock Text="📂" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Storage &amp; Shared Folders" FontSize="16" FontWeight="Bold" Foreground="#F1F5F9" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Public Space Folder -->
                        <TextBlock Text="Public Space Folder (Read-Only Shared on LAN)" Foreground="#F1F5F9" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding PublicSpacePath}" IsReadOnly="True" 
                                     Background="#0D1321" Foreground="#60A5FA" BorderBrush="#1E293B" BorderThickness="1"
                                     Padding="12,10" FontSize="13"/>
                            <Button Grid.Column="1" Content="📂 Browse..." Command="{Binding BrowsePublicSpaceFolderCommand}" Style="{StaticResource ModernPrimaryButton}" Margin="10,0,0,0" FontSize="12" Padding="14,8"/>
                            <Button Grid.Column="2" Content="📁 Open" Command="{Binding OpenFolderInExplorerCommand}" CommandParameter="{Binding PublicSpacePath}" Style="{StaticResource GhostButton}" Margin="6,0,0,0" FontSize="12" Padding="12,8"/>
                        </Grid>

                        <!-- Received Files Folder -->
                        <TextBlock Text="Received Files Storage Root" Foreground="#F1F5F9" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding ReceivedFilesRoot}" IsReadOnly="True" 
                                     Background="#0D1321" Foreground="#10B981" BorderBrush="#1E293B" BorderThickness="1"
                                     Padding="12,10" FontSize="13"/>
                            <Button Grid.Column="1" Content="📂 Browse..." Command="{Binding BrowseReceivedFilesFolderCommand}" Style="{StaticResource ModernPrimaryButton}" Margin="10,0,0,0" FontSize="12" Padding="14,8"/>
                            <Button Grid.Column="2" Content="📥 Open" Command="{Binding OpenFolderInExplorerCommand}" CommandParameter="{Binding ReceivedFilesRoot}" Style="{StaticResource GhostButton}" Margin="6,0,0,0" FontSize="12" Padding="12,8"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ═══════════════════════════════════════════ -->
                <!-- CARD 2.5: Notifications & Alerts           -->
                <!-- ═══════════════════════════════════════════ -->
                <Border CornerRadius="14" Padding="22" Margin="0,0,0,20" BorderThickness="1" BorderBrush="#1A2744">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#0E1525" Offset="0"/>
                            <GradientStop Color="#0B1120" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="🔔" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Windows Notifications &amp; Alerts" FontSize="16" FontWeight="Bold" Foreground="#F1F5F9"/>
                            </StackPanel>
                            <TextBlock Text="Show a notification alert whenever a file is received from another peer (Default: ON)." Foreground="#64748B" FontSize="12.5" TextWrapping="Wrap" Margin="28,0,0,0"/>
                        </StackPanel>

                        <CheckBox Grid.Column="1" IsChecked="{Binding EnableNotifications, Mode=TwoWay}" Content="Enable Alerts" Style="{StaticResource HighVisibilityCheckBoxStyle}" Foreground="#10B981" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- ═══════════════════════════════════════════ -->
                <!-- CARD 3: Device Information                 -->
                <!-- ═══════════════════════════════════════════ -->
                <Border CornerRadius="14" Padding="22" Margin="0,0,0,20" BorderThickness="1" BorderBrush="#1A2744">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#0E1525" Offset="0"/>
                            <GradientStop Color="#0B1120" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="📱" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Device Information" FontSize="16" FontWeight="Bold" Foreground="#F1F5F9"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="28,0,0,0">
                                <Border CornerRadius="6" Padding="8,4" Margin="0,0,12,0">
                                    <Border.Background>
                                        <SolidColorBrush Color="#3B82F6" Opacity="0.1"/>
                                    </Border.Background>
                                    <TextBlock Text="{Binding LocalIp, StringFormat='Local IP: {0}'}" Foreground="#60A5FA" FontSize="12" FontWeight="SemiBold"/>
                                </Border>
                                <TextBlock Text="{Binding DeviceId, StringFormat='Device ID: {0}'}" Foreground="#64748B" FontSize="11.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>

                        <Button Grid.Column="1" Content="📋 Copy Device ID" Command="{Binding CopyDeviceIdToClipboardCommand}" Style="{StaticResource GhostButton}" FontSize="12" Padding="14,8" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- ═══════════════════════════════════════════════════ -->
                <!-- CARD 4: Software Updates & Release Maintenance     -->
                <!-- ═══════════════════════════════════════════════════ -->
                <Border CornerRadius="14" Padding="1" Margin="0,0,0,24">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#2563EB" Offset="0"/>
                            <GradientStop Color="#7C3AED" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border CornerRadius="13" Padding="22">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#0E1525" Offset="0"/>
                                <GradientStop Color="#0B1120" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🚀" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Software Updates &amp; Release Maintenance" FontSize="16" FontWeight="Bold" Foreground="#F1F5F9" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                    <Border Background="#0D1321" CornerRadius="7" Padding="10,5" BorderBrush="#1A2744" BorderThickness="1">
                                        <TextBlock Text="{Binding CurrentVersion}" Foreground="#60A5FA" FontSize="12" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                                <Button Content="🔍  Check for Updates" Command="{Binding CheckForUpdatesCommand}" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" FontSize="12" Padding="14,8"/>
                            </Grid>

                            <!-- Status text -->
                            <TextBlock Text="{Binding UpdateStatusMessage}" Foreground="#94A3B8" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,14"/>

                            <!-- Update Progress Bar -->
                            <ProgressBar Visibility="{Binding IsDownloadingUpdate, Converter={StaticResource BooleanToVisibilityConverter}}" Value="{Binding UpdateProgressPercentage, Mode=OneWay}" Maximum="100" Height="6" Background="#131B2E" BorderThickness="0" Margin="0,0,0,14">
                                <ProgressBar.Foreground>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#2563EB" Offset="0"/>
                                        <GradientStop Color="#3B82F6" Offset="0.5"/>
                                        <GradientStop Color="#60A5FA" Offset="1"/>
                                    </LinearGradientBrush>
                                </ProgressBar.Foreground>
                            </ProgressBar>

                            <!-- Update Available Banner -->
                            <Border Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BooleanToVisibilityConverter}}" CornerRadius="10" Padding="16" BorderThickness="1" BorderBrush="#10B981">
                                <Border.Background>
                                    <SolidColorBrush Color="#10B981" Opacity="0.06"/>
                                </Border.Background>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="📥  Download &amp; Install Now" Command="{Binding ApplyUpdateCommand}" Style="{StaticResource ModernSuccessButton}" FontSize="13" Padding="18,10" VerticalAlignment="Center"/>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                                        <TextBlock Text="{Binding AvailableUpdateInfo.Version, StringFormat='Update Available: v{0}'}" Foreground="#34D399" FontSize="15" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding AvailableUpdateInfo.Changelog}" Foreground="#64748B" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Border>

                <!-- ═══════════════════════════════════════════════════ -->
                <!-- CARD 5: About & Developer Information             -->
                <!-- ═══════════════════════════════════════════════════ -->
                <Border CornerRadius="14" Padding="22" Margin="0,0,0,24" BorderThickness="1" BorderBrush="#1A2744">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#0E1525" Offset="0"/>
                            <GradientStop Color="#0B1120" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <!-- Header & Version -->
                        <Grid Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="ℹ️" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="About 360 LocalShare" FontSize="16" FontWeight="Bold" Foreground="#F1F5F9" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <Border Background="#0D1321" CornerRadius="6" Padding="8,4" BorderBrush="#1A2744" BorderThickness="1">
                                    <TextBlock Text="{Binding CurrentVersion}" Foreground="#60A5FA" FontSize="12" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Software Description -->
                        <TextBlock Text="360 LocalShare is a secure, high-speed peer-to-peer Local Area Network (LAN) file sharing, instant messaging, and public space file discovery application. Built with .NET 10 and WPF Fluent Design, it provides zero-cloud local networking with private local transfers."
                                   Foreground="#94A3B8" FontSize="13" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,18"/>

                        <Border Height="1" Background="#162033" Margin="0,0,0,18"/>

                        <!-- Developer Info Grid -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="DEVELOPER DETAILS" FontSize="10.5" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="👨‍💻 " FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding DeveloperName}" FontSize="15" FontWeight="Bold" Foreground="#F1F5F9" VerticalAlignment="Center"/>
                                    <Border CornerRadius="4" Padding="6,2" Margin="10,0,0,0" Background="#131B2E" VerticalAlignment="Center">
                                        <TextBlock Text="Lead Engineer &amp; Creator" FontSize="11" Foreground="#818CF8" FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="360 Productions" FontSize="12" Foreground="#64748B" Margin="22,0,0,0"/>
                            </StackPanel>

                            <!-- Website Link Button -->
                            <Button Grid.Column="1" Command="{Binding OpenDeveloperWebsiteCommand}" Style="{StaticResource GhostButton}" Padding="14,10" VerticalAlignment="Center" Cursor="Hand">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🌐 " FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="https://razorisuru.com" FontSize="13" FontWeight="SemiBold" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="↗" FontSize="13" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ═══════════════════════════════════ -->
                <!-- SAVE BUTTON                        -->
                <!-- ═══════════════════════════════════ -->
                <Button Content="💾  Save Profile Settings" Command="{Binding SaveProfileCommand}" Style="{StaticResource ModernPrimaryButton}" FontSize="16" Padding="28,14" HorizontalAlignment="Left" Margin="0,0,0,24"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
