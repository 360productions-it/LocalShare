<UserControl x:Class="LocalShare.App.Views.GroupsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Grid Margin="28,24,28,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════════════════════════════ -->
        <!-- GROUPS ROSTER (Left Panel)         -->
        <!-- ═══════════════════════════════════ -->
        <Border CornerRadius="14" Padding="20" Margin="0,0,14,0" BorderThickness="1" BorderBrush="#1A2744">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#0E1525" Offset="0"/>
                    <GradientStop Color="#0B1120" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel>
                <!-- Header -->
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,20">
                    <TextBlock Text="Groups" FontSize="24" FontWeight="Bold">
                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#60A5FA" Offset="0.0"/>
                                <GradientStop Color="#818CF8" Offset="1.0"/>
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                    </TextBlock>
                    <TextBlock Text="Manage your device groups" FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Create Group Input -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding NewGroupName, UpdateSourceTrigger=PropertyChanged}" 
                             Background="#0D1321" Foreground="White" BorderBrush="#1E293B" BorderThickness="1"
                             Padding="12,10" FontSize="13" CaretBrush="#60A5FA" SelectionBrush="#2563EB"
                             Margin="0,0,8,0"/>
                    <Button Grid.Column="1" Content="+ Create" Command="{Binding CreateGroupCommand}" Style="{StaticResource ModernPrimaryButton}" FontSize="12" Padding="14,8"/>
                </Grid>

                <!-- Groups List -->
                <ListBox ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" 
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,6"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="cardBd" Background="#0D1321" CornerRadius="10" Padding="14,12" BorderThickness="1" BorderBrush="#162033">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="cardBd" Property="Background" Value="#111B2E"/>
                                                <Setter TargetName="cardBd" Property="BorderBrush" Value="#1E293B"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="cardBd" Property="Background" Value="#0F1D38"/>
                                                <Setter TargetName="cardBd" Property="BorderBrush" Value="#2563EB"/>
                                                <Setter TargetName="cardBd" Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect BlurRadius="14" Color="#2563EB" Direction="0" ShadowDepth="0" Opacity="0.15"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Group Icon -->
                                <Border Width="36" Height="36" CornerRadius="18" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#1D4ED8" Offset="0"/>
                                            <GradientStop Color="#7C3AED" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <TextBlock Text="👥" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="#F1F5F9" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <!-- Member count badge -->
                                <Border Grid.Column="2" CornerRadius="10" Padding="8,4" VerticalAlignment="Center">
                                    <Border.Background>
                                        <SolidColorBrush Color="#3B82F6" Opacity="0.12"/>
                                    </Border.Background>
                                    <TextBlock Text="{Binding Members.Count, StringFormat='{}{0} Members'}" FontSize="10.5" FontWeight="SemiBold" Foreground="#60A5FA"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ═══════════════════════════════════ -->
        <!-- SELECTED GROUP DETAILS (Right)     -->
        <!-- ═══════════════════════════════════ -->
        <Border Grid.Column="1" CornerRadius="14" Padding="24" BorderThickness="1" BorderBrush="#1A2744">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#0E1525" Offset="0"/>
                    <GradientStop Color="#0B1120" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Group Name Header -->
                <StackPanel Margin="0,0,0,24">
                    <TextBlock FontSize="26" FontWeight="Bold">
                        <TextBlock.Text>
                            <Binding Path="SelectedGroup.Name" FallbackValue="Select or Create a Group"/>
                        </TextBlock.Text>
                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#60A5FA" Offset="0.0"/>
                                <GradientStop Color="#38BDF8" Offset="0.5"/>
                                <GradientStop Color="#818CF8" Offset="1.0"/>
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                    </TextBlock>
                    <TextBlock Text="Group Details &amp; Members" FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Members List -->
                <DockPanel Grid.Row="1">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14" VerticalAlignment="Center">
                        <TextBlock Text="👥" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Group Members" FontSize="16" FontWeight="SemiBold" Foreground="#F1F5F9"/>
                    </StackPanel>
                    
                    <ListBox ItemsSource="{Binding SelectedGroup.Members}" 
                             Background="Transparent" BorderThickness="0">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,6"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="memBd" Background="#0D1321" CornerRadius="10" Padding="12,10" BorderThickness="1" BorderBrush="#162033">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="memBd" Property="Background" Value="#111B2E"/>
                                                    <Setter TargetName="memBd" Property="BorderBrush" Value="#1E293B"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Avatar Circle -->
                                    <Border Width="36" Height="36" CornerRadius="18" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#2563EB" Offset="0"/>
                                                <GradientStop Color="#7C3AED" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <TextBlock Text="👤" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{Binding DisplayName}" Foreground="#F1F5F9" FontSize="14" FontWeight="Medium" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <!-- Add Member Panel -->
                <Border Grid.Row="2" CornerRadius="12" Padding="16" Margin="0,18,0,0" BorderThickness="1" BorderBrush="#1A2744">
                    <Border.Background>
                        <SolidColorBrush Color="#131B2E"/>
                    </Border.Background>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                            <TextBlock Text="➕" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Add LAN Peer" Foreground="#F1F5F9" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>

                        <ComboBox Grid.Column="1" ItemsSource="{Binding AvailablePeers}" DisplayMemberPath="DisplayName" x:Name="PeerCombo" 
                                  VerticalAlignment="Center" Margin="0,0,12,0"
                                  Background="#0D1321" Foreground="White" BorderBrush="#1E293B"/>

                        <Button Grid.Column="2" Content="Add to Group" 
                                Command="{Binding AddMemberToGroupCommand}" 
                                CommandParameter="{Binding SelectedItem, ElementName=PeerCombo}" 
                                Style="{StaticResource ModernPrimaryButton}" FontSize="12" Padding="14,8"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
