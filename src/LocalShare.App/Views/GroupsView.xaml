<UserControl x:Class="LocalShare.App.Views.GroupsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Groups Roster -->
        <Border Background="#1E1E1E" CornerRadius="8" Padding="15" Margin="0,0,10,0">
            <DockPanel>
                <TextBlock Text="Groups" FontSize="20" FontWeight="Bold" Foreground="White" DockPanel.Dock="Top" Margin="0,0,0,15"/>

                <Grid DockPanel.Dock="Top" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding NewGroupName, UpdateSourceTrigger=PropertyChanged}" Background="#2B2B2B" Foreground="White" Padding="5"/>
                    <Button Grid.Column="1" Content="Create" Command="{Binding CreateGroupCommand}" Background="#0078D4" Foreground="White" Margin="5,0,0,0"/>
                </Grid>

                <ListBox ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="5">
                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock Text="{Binding Members.Count, StringFormat='{}{0} Members'}" FontSize="12" Foreground="#888888"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Selected Group Details -->
        <Border Grid.Column="1" Background="#242424" CornerRadius="8" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="{Binding SelectedGroup.Name, FallbackValue='Select or Create a Group'}" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,0,0,15"/>

                <!-- Members List -->
                <DockPanel Grid.Row="1">
                    <TextBlock Text="Group Members" FontSize="16" FontWeight="SemiBold" Foreground="White" DockPanel.Dock="Top" Margin="0,0,0,10"/>
                    <ListBox ItemsSource="{Binding SelectedGroup.Members}" Background="#1E1E1E" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" Foreground="White" FontSize="14" Margin="5"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <!-- Add Member Panel -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,15,0,0">
                    <TextBlock Text="Add LAN Peer: " Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox ItemsSource="{Binding AvailablePeers}" DisplayMemberPath="DisplayName" x:Name="PeerCombo" Width="200"/>
                    <Button Content="Add to Group" Command="{Binding AddMemberToGroupCommand}" CommandParameter="{Binding SelectedItem, ElementName=PeerCombo}" Background="#0078D4" Foreground="White" Margin="10,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
